// Windows resource script for PromoAccess.
// Embeds the manifest (DPI + common controls v6) and the VERSIONINFO block that
// Explorer and the Programs list read.
//
// The icon is the ReaperAccessible mark on the PromoAccess blue: the family is
// recognisable at a glance and the maker is written on the artwork itself.
// Named rather than numbered so the window can load it by name as well —
// Explorer takes the first icon resource for the file, wxWidgets needs a name
// for the taskbar and Alt+Tab.

#include <windows.h>

AppIcon ICON "PromoAccess.ico"

// 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID (the manifest for the .exe itself).
1 RT_MANIFEST "PromoAccess.manifest"

1 VERSIONINFO
 FILEVERSION     1,0,6,0
 PRODUCTVERSION  1,0,6,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          VOS__WINDOWS32
 FILETYPE        VFT_APP
 FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "ReaperAccessible"
            VALUE "FileDescription",  "PromoAccess"
            VALUE "FileVersion",      "1.06"
            VALUE "InternalName",     "PromoAccess"
            VALUE "LegalCopyright",   "Copyright (C) 2026 ReaperAccessible"
            VALUE "OriginalFilename", "PromoAccess.exe"
            VALUE "ProductName",      "PromoAccess"
            VALUE "ProductVersion",   "1.06"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
